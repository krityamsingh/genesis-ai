# admin/frontend/.env
# Created — this file was missing entirely, so VITE_ADMIN_API_URL was always
# undefined and AdminLogin.jsx fell back to '/api/admin' (which is correct now
# that api/routes.py mounts admin_app at that path).
# If you run the backend on a different host/port, change the URL below.

VITE_ADMIN_API_URL=/api/admin
