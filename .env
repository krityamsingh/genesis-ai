# ============================================================
# GENESIS AI — Environment Variables (MongoDB Edition)
# ============================================================

# ── MongoDB (replaces DATABASE_URL + REDIS_URL) ────────────
MONGO_URL=mongodb://localhost:27017
# For Atlas: mongodb+srv://user:pass@cluster.mongodb.net/
MONGO_DB_NAME=genesis_ai

# ── Admin account ──────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Genesis@2024!
ADMIN_EMAIL=admin@genesis.ai
# Optional: auto-grant admin to this phone number (OTP login)
ADMIN_PHONE=

# ── JWT ────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_HOURS=24

# ── Google OAuth ───────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173
SESSION_SECRET_KEY=change-this-to-a-32-char-hex-string

# ── Twilio OTP SMS ─────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── AI Models ──────────────────────────────────────────────
HF_TOKEN=
GEMMA_MODEL=google/gemma-2b-it
GOOGLE_API_KEY=
OPENAI_API_KEY=

# ── CORS ───────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── App ────────────────────────────────────────────────────
ENV=development
PORT=8000

# ── Hooks ──────────────────────────────────────────────────
RUN_SEEDS=false
RESET_ADMIN_PASSWORD=false

# ── REMOVED (no longer needed) ─────────────────────────────
# DATABASE_URL  → replaced by MONGO_URL
# REDIS_URL     → replaced by MongoDB TTL indexes
