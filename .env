# =============================================================
# GENESIS — Complete Environment Configuration
# =============================================================

# ── Authentication ───────────────────────────────────────────
# Admin login credentials (used by scripts/seed_data.py to create the first user)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Genesis@Admin2024!
ADMIN_EMAIL=admin@genesis.local

# JWT secret for signing tokens — already generated, do NOT change after first run
JWT_SECRET=585cd3754e99f962e5403e4831e394723493b6350e3b38ce7511419d68ed1e03
JWT_EXPIRE_HOURS=24

# Optional: set this ONLY during key rotation (remove after old tokens expire)
# JWT_SECRET_OLD=

# ── Database ─────────────────────────────────────────────────
# SQLite (default — works out of the box, no setup needed)
DATABASE_URL=sqlite:///./genesis.db

# PostgreSQL (uncomment and fill in if using Postgres instead)
# DATABASE_URL=postgresql://user:password@localhost:5432/genesis

# ── AI / Models ──────────────────────────────────────────────
# HuggingFace token (required for Gemma model downloads)
HF_TOKEN=hf_REPLACE_WITH_YOUR_HUGGINGFACE_TOKEN

# Gemma model variant: default | fast | mini | code
GEMMA_MODEL=default

# OpenAI (optional — only needed if using OpenAI-backed modules)
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_OPENAI_KEY
OPENAI_MODEL=gpt-4o

# Gemini (optional — only needed if using Gemini-backed modules)
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_KEY
GEMINI_MODEL=gemini-1.5-pro

# Grok (optional — only needed if using Grok-backed modules)
GROK_API_KEY=REPLACE_WITH_YOUR_GROK_KEY
GROK_MODEL=grok-1

# ── Vector Store (Knowledge Graph / ChromaDB) ─────────────────
# Local ChromaDB storage directory
KG_PERSIST_DIR=./data/chroma

# Remote ChromaDB (uncomment only if using hosted ChromaDB, otherwise leave commented)
# CHROMA_HOST=api.trychroma.com
# CHROMA_API_KEY=ck-REPLACE_WITH_YOUR_CHROMA_KEY
# CHROMA_TENANT=your-tenant-id
# CHROMA_DATABASE=your-database-name

# ── Redis (optional — enables token blacklisting on logout) ───
# Leave commented out if you don't have Redis — logout still works without it
# REDIS_URL=redis://localhost:6379/0

# ── Server ───────────────────────────────────────────────────
PORT=8080

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Seeding ──────────────────────────────────────────────────
# Set to true to auto-run seed_data.py on server start
RUN_SEEDS=true

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=text
# LOG_FILE=./logs/genesis.log

# ── Module Tuning ─────────────────────────────────────────────
RESEARCH_CONFIDENCE_THRESHOLD=0.7
HEAL_MAX_ATTEMPTS=3

# ── Debug ────────────────────────────────────────────────────
# Set to true only in development — never in production
DEBUG=false
