# =============================================================
# GENESIS — Environment Configuration
# =============================================================

# ── AI / Models ──────────────────────────────────────────────
# Required: Your HuggingFace API token
HF_TOKEN=hf_...

# Model variants: default | fast | mini | code
GEMMA_MODEL=default

# ── Authentication ───────────────────────────────────────────
# Admin credentials (used by scripts/seed_data.py)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
ADMIN_EMAIL=admin@genesis.local

# Secret for signing JWT tokens (use a long random string in production)
JWT_SECRET=genesis-dev-secret-CHANGE-IN-PROD
JWT_EXPIRE_HOURS=24

# ── Database ──────────────────────────────────────────────────
# Default is local SQLite. For production, use postgresql://...
# DATABASE_URL=sqlite:///./genesis.db

# ── Vector Store (Knowledge Graph) ───────────────────────────
# Directory where ChromaDB will persist its data
KG_PERSIST_DIR=./data/chroma

# ── Server ───────────────────────────────────────────────────
# Allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
PORT=8000
